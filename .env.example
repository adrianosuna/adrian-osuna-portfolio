# ── DESARROLLO LOCAL ─────────────────────────────────────────────────────
# (para producción con Docker, ver .env.production.example)

# Conexión MySQL — BD local ao_test, heredada del Portfolio antiguo (ya
# retirado); el usuario aosuna solo tiene permisos sobre esa BD
DATABASE_URL="mysql://usuario:password@127.0.0.1:3306/db"

# Bootstrap del allowlist: este correo se crea como admin activo en el seed
ADMIN_EMAIL="correo-del-admin@gmail.com"

# NextAuth
AUTH_SECRET="genera-uno-con: npx auth secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Analytics 4 (opcional; en desarrollo normalmente vacío). Con ID
# (G-XXXXXXXXXX) se activa el banner de cookies y la analítica tras consentir.
NEXT_PUBLIC_GA_ID=""

# Visitas del Panel de control (opcional): service account de Google Cloud
# con acceso de Lector a la propiedad GA4 (procedimiento en docs/DESPLIEGUE.md).
# GA_PROPERTY_ID: id NUMÉRICO de la propiedad (no el G-XXXX). La clave privada
# va en una sola línea con los saltos escapados como \n (tal cual en el JSON).
GA_PROPERTY_ID=""
GA_SA_CLIENT_EMAIL=""
GA_SA_PRIVATE_KEY=""

# Avisos de mantenimiento por correo (opcional). El cron interno NO se programa
# en desarrollo aunque haya SMTP: solo corre en producción. Ver
# .env.production.example.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
ALERT_EMAIL=""

# Forzar el cron en desarrollo para probarlo a mano (por defecto no corre en
# dev). Ojo: con SMTP configurado enviaría correos reales y apuntaría los
# recurrentes vencidos en la BD local.
# CRON_EN_DEV="1"

# AUTH_URL y NEXT_PUBLIC_SITE_URL no hacen falta en desarrollo (caen a
# http://localhost:9444); son OBLIGATORIAS en producción (ver
# .env.production.example). Descomenta si quieres fijarlas en local.
# NEXT_PUBLIC_SITE_URL="http://localhost:9444"

# ─────────── Notificaciones push (opcional) ───────────
# Sin estas claves el push queda inactivo (el interruptor del menú de perfil lo
# dice y no se ofrece); el aviso por correo del cron sigue funcionando igual.
# Se generan UNA vez con:   npx web-push generate-vapid-keys
# La pública NO es secreta (el navegador la necesita para suscribirse); la
# privada sí. Ninguna se hornea en el build: se leen en runtime.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# Quién envía, ante el servicio de push: un mailto: o la URL del sitio.
# Si se omite, se usa NEXT_PUBLIC_SITE_URL.
# VAPID_SUBJECT="mailto:tu@correo.com"
#
# ⚠ En iPhone/iPad el push SOLO llega si la app está añadida a la pantalla de
# inicio (iOS 16.4+). En Safari a pelo el navegador no ofrece el permiso.

# ─────────── Registro (opcional) ───────────
# Suelo de severidad del log: debug | info | warn | error. Por defecto, `debug`
# en desarrollo e `info` en producción. En producción cada evento sale como una
# línea JSON (docker compose logs | jq); en desarrollo, en formato corto.
# LOG_LEVEL="debug"

# ─────────── Caducidad de la sesión (opcional) ───────────
# Dos plazos independientes (ver src/lib/sesion-caducidad.ts):
#   SESION_DIAS               tope absoluto desde el login (1-90, por defecto 7)
#   SESION_INACTIVIDAD_HORAS  cierre por inactividad (0 = desactivado, por
#                             defecto 48): una sesión olvidada en un navegador
#                             ajeno se cierra sola sin esperar al tope.
# SESION_DIAS="7"
# SESION_INACTIVIDAD_HORAS="48"
