# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# prisma client generado
/src/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright: informes y artefactos de los e2e (se regeneran en cada ejecución).
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Informes del analizador de bundle (`pnpm analyze`).
/.next/analyze/

# Carpetas de build alternativas (NEXT_DIST_DIR): los e2e usan .next-e2e para
# no pisar el .next del dev server.
/.next-*
