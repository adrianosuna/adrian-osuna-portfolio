# Producción con Docker (copiar a .env.production y rellenar).
# Lo usan tanto los contenedores (env_file) como el propio compose
# (interpolación): docker compose --env-file .env.production ...

# ── Base de datos (contenedor `db`, BD nueva desde cero) ─────────────────
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Conexión de la app: el host es `db` (nombre del servicio en la red de compose)
# y las credenciales deben coincidir con las MYSQL_* de arriba.
DATABASE_URL="mysql://portfolio:MISMA-MYSQL_PASSWORD@db:3306/portfolio"

# ── Aplicación ────────────────────────────────────────────────────────────
# Correo asegurado como admin activo por el seed (paso `migrate`).
ADMIN_EMAIL=""

# NextAuth: secreto NUEVO para producción (npx auth secret) y el cliente
# OAuth de Google con la redirect URI https://adrianosuna.com/api/auth/callback/google
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# URLs públicas. NEXT_PUBLIC_SITE_URL se hornea en el BUILD de la imagen:
# si se cambia, hay que reconstruir (docker compose build).
AUTH_URL="https://adrianosuna.com"
NEXT_PUBLIC_SITE_URL="https://adrianosuna.com"

# Google Analytics 4: ID de medición. También se hornea en el BUILD (cambiarlo
# requiere reconstruir la imagen). Vacío = sin analítica ni banner de cookies.
NEXT_PUBLIC_GA_ID="G-04BLBZ1KMM"

# ── Monitor de infraestructura ────────────────────────────────────────────
# Carpeta del HOST con los dumps del cron de backup, montada de solo lectura
# en el contenedor. Solo hace falta definirla si no es la ruta por defecto.
# BACKUPS_HOST_DIR=/home/ubuntu/backups

# ── Avisos por correo del cron interno (diario a las 8:00) ────────────────
# SMTP para los tres avisos: mantenimiento vencido, seguimientos del pipeline
# y meses de ahorro sin rellenar.
# Con el correo del dominio (Zimbra de OVH): host smtp.mail.ovh.net, puerto
# 465, SMTP_USER = el correo COMPLETO (info@...) y SMTP_PASS = su contraseña.
# (Alternativa Gmail: smtp.gmail.com + contraseña de aplicación.)
# ALERT_EMAIL = destinatario de los avisos. Sin estas variables, los avisos
# quedan inactivos (la pestaña sigue funcionando).
SMTP_HOST="smtp.mail.ovh.net"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
ALERT_EMAIL=""

# ── Visitas (Panel de control · GA Data API) ──────────────────────────────
# Service account de Google Cloud con acceso de Lector a la propiedad GA4
# (procedimiento en docs/DESPLIEGUE.md). GA_PROPERTY_ID es el id NUMÉRICO de
# la propiedad (no el G-XXXX). La clave privada va en una sola línea con los
# saltos escapados como \n, tal cual viene en el JSON descargado.
GA_PROPERTY_ID=""
GA_SA_CLIENT_EMAIL=""
GA_SA_PRIVATE_KEY=""

# ─────────── Notificaciones push (opcional) ───────────
# Generar una vez con `npx web-push generate-vapid-keys` y pegarlas aquí. Sin
# ellas el push queda inactivo y el resto de avisos (correo) sigue igual.
# La privada es un SECRETO: no se hornea en el build, se lee en runtime.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:adrianosunaalbala@gmail.com"

# ─────────── Registro (opcional) ───────────
# Suelo de severidad: debug | info | warn | error (por defecto `info` en
# producción). Cada evento sale como una línea JSON, así que se filtra con:
#   docker compose logs web | jq 'select(.nivel=="error")'
# LOG_LEVEL="info"

# ─────────── Caducidad de la sesión (opcional) ───────────
# SESION_DIAS               tope absoluto desde el login (1-90, por defecto 7)
# SESION_INACTIVIDAD_HORAS  cierre por inactividad (0 = desactivado, def. 48)
# Las dos se leen en RUNTIME: cambiarlas solo pide reiniciar el contenedor.
# SESION_DIAS="7"
# SESION_INACTIVIDAD_HORAS="48"
